# PGCB Organization Portal — HostSeba Production Environment (.env.production.example)
# NEVER commit real production secrets to Git. Copy to .env in services/api on HostSeba.

APP_ENV=production

# PostgreSQL Database (HostSeba local or managed PostgreSQL)
DATABASE_URL=postgresql+psycopg://pgcb_prod_user:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/pgcb_portal_prod
DB_SSLMODE=prefer

# Security & Encryption Secrets (Must be >= 32 characters)
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_PRODUCTION_SECRET
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token
MFA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_32_BYTE_BASE64_KEY

# Domain & Reverse Proxy (Cloudflare -> HostSeba)
FRONTEND_URL=https://pgcb.org.bd
ALLOWED_ORIGINS=https://pgcb.org.bd,https://www.pgcb.org.bd
TRUSTED_PROXY_COUNT=1
REQUIRE_EMAIL_VERIFICATION=true

# Rate Limiting & Metrics (No Redis or Celery required on HostSeba)
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=false
METRICS_ENABLED=true
METRICS_TOKEN=REPLACE_WITH_METRICS_BEARER_TOKEN

# Persistent Local Filesystem Storage on HostSeba
STORAGE_BACKEND=local
STORAGE_ROOT=/home/pgcb/uploads
MAX_UPLOAD_MB=10

# SMTP Email Configuration
SMTP_HOST=mail.pgcb.org.bd
SMTP_PORT=587
SMTP_USERNAME=noreply@pgcb.org.bd
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=PGCB Engineers Secretariat <noreply@pgcb.org.bd>

# Payment Gateway Credentials (bKash / Nagad / SSLCommerz)
BKASH_APP_KEY=REPLACE_WITH_BKASH_APP_KEY
BKASH_APP_SECRET=REPLACE_WITH_BKASH_APP_SECRET
BKASH_USERNAME=REPLACE_WITH_BKASH_USERNAME
BKASH_PASSWORD=REPLACE_WITH_BKASH_PASSWORD
BKASH_WEBHOOK_SECRET=REPLACE_WITH_BKASH_WEBHOOK_SECRET

NAGAD_MERCHANT_ID=REPLACE_WITH_NAGAD_MERCHANT_ID
NAGAD_PUBLIC_KEY=REPLACE_WITH_NAGAD_PUBLIC_KEY
NAGAD_PRIVATE_KEY=REPLACE_WITH_NAGAD_PRIVATE_KEY
NAGAD_WEBHOOK_SECRET=REPLACE_WITH_NAGAD_WEBHOOK_SECRET

SSLCOMMERZ_STORE_ID=REPLACE_WITH_SSLCOMMERZ_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=REPLACE_WITH_SSLCOMMERZ_STORE_PASSWORD
SSLCOMMERZ_WEBHOOK_SECRET=REPLACE_WITH_SSLCOMMERZ_WEBHOOK_SECRET

PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_GLOBAL_WEBHOOK_HMAC_SECRET
LOG_LEVEL=INFO
