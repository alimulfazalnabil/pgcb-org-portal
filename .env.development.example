# PGCB Organization Portal — Development Environment (.env.development.example)
APP_ENV=development
DATABASE_URL=sqlite:///./pgcb_portal.db
JWT_SECRET=dev-only-secret-change-me-please-use-a-32-byte-random-secret
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=false
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
LOG_LEVEL=DEBUG
