# ==============================================================================
# PGCB Organization Portal — Backend API Environment Template
# ==============================================================================
# Target Platform: HostSeba cPanel / CloudLinux / Phusion Passenger
# Production Subdomain: https://api.powergriddiprocoush.org
# Frontend Domain: https://powergriddiprocoush.org
# Python: 3.11 (with Psycopg 3 driver)
# ==============================================================================

# 1. Environment & Mode
# Use 'production' on HostSeba, 'development' on local machine
APP_ENV=production
LOG_LEVEL=INFO

# 2. Database Connection (PostgreSQL Psycopg 3)
# On HostSeba cPanel, create a PostgreSQL database and user via cPanel -> PostgreSQL Databases.
# Provide either the complete DATABASE_URL or the discrete DB_* fields below:
DATABASE_URL=postgresql+psycopg://powergri_pgcbuser:ReplaceWithStrongDbPassword@localhost:5432/powergri_pgcb_prod
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=powergri_pgcb_prod
# DB_USER=powergri_pgcbuser
# DB_PASSWORD=ReplaceWithStrongDbPassword
# DB_SSLMODE=prefer

# Safeguards: Production rejects SQLite by default to prevent accidental ephemeral resets.
ALLOW_SQLITE_IN_PRODUCTION=false
ALLOW_STARTUP_FALLBACK=false

# 3. Cryptography & Authentication (NEVER commit real keys)
# Must be at least 32 characters long in staging/production
JWT_SECRET=replace-with-a-cryptographically-random-64-char-hex-secret
SECRET_KEY=replace-with-a-cryptographically-random-64-char-hex-secret
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token

# MFA Encryption Key: 32-byte urlsafe base64 Fernet key.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=replace-with-generated-fernet-key-32-bytes-base64==

# 4. CORS & Origins
FRONTEND_URL=https://powergriddiprocoush.org
ALLOWED_ORIGINS=https://powergriddiprocoush.org

# 5. Persistent File Storage (Outside public web root)
STORAGE_BACKEND=local
STORAGE_ROOT=/home/powergri/storage
UPLOAD_DIR=/home/powergri/storage/uploads
MAX_UPLOAD_MB=10

# 6. Security & Rate Limiting
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=false
# If Redis is available:
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
TRUSTED_PROXY_COUNT=1

# 7. Account Lifecycle
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_RESET_HOURS=2
EMAIL_VERIFICATION_HOURS=24

# 8. Transactional Email & SMS
SMTP_HOST=mail.powergriddiprocoush.org
SMTP_PORT=587
SMTP_USERNAME=noreply@powergriddiprocoush.org
SMTP_PASSWORD=replace-with-cpanel-email-password
SMTP_FROM=PGCB Secretariat <noreply@powergriddiprocoush.org>
SMS_PROVIDER_URL=
SMS_PROVIDER_NAME=CUSTOM_HTTP

# 9. Payment Gateways (Sandbox by default until merchant verification)
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=
BKASH_CHECKOUT_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_WEBHOOK_SECRET=
NAGAD_CHECKOUT_URL=https://api.mynagad.com/api/dfs
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_WEBHOOK_SECRET=
SSLCOMMERZ_CHECKOUT_URL=https://securepay.sslcommerz.com

# 10. Observability & Background Jobs
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-secure-metrics-bearer-token
WORKER_INTERVAL_SECONDS=30
