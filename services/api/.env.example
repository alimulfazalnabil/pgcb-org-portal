APP_ENV=development
DATABASE_URL=sqlite:///./pgcb_portal.db
DB_HOST=
DB_PORT=5432
DB_NAME=pgcb_portal
DB_USER=
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token
FRONTEND_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_RESET_HOURS=2
EMAIL_VERIFICATION_HOURS=24
MAX_UPLOAD_MB=10

# Storage: local for development/test, persistent_disk for production (Render Persistent Disk)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

MFA_ENCRYPTION_KEY=
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SCHEME=redis
REDIS_TLS_VERIFY=true
TRUSTED_PROXY_COUNT=1
METRICS_ENABLED=true
LOG_LEVEL=INFO

# Background worker
WORKER_INTERVAL_SECONDS=30

# Email/SMS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org
SMS_PROVIDER_URL=
SMS_PROVIDER_NAME=CUSTOM_HTTP

# Payment gateway adapters
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
BKASH_WEBHOOK_SECRET=
NAGAD_WEBHOOK_SECRET=
SSLCOMMERZ_WEBHOOK_SECRET=
BKASH_CHECKOUT_URL=
NAGAD_CHECKOUT_URL=
SSLCOMMERZ_CHECKOUT_URL=

METRICS_TOKEN=
