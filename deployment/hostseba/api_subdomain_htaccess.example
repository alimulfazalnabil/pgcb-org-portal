# ==============================================================================
# CloudLinux / LiteSpeed Passenger Configuration for api.powergriddiprocoush.org
# Document Root: /home/powergri/api.powergriddiprocoush.org/.htaccess
# ==============================================================================

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/powergri/repositories/pgcb-org-portal/services/api"
PassengerBaseURI "/"
PassengerPython "/home/powergri/virtualenv/repositories/pgcb-org-portal/services/api/3.11/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Explicit LiteSpeed / Passenger Activation Directives
PassengerEnabled on
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py

# Security & Performance Directives
Options -Indexes -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Security Headers (CORS is managed natively by FastAPI CORSMiddleware)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
