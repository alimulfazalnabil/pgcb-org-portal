# ==============================================================================
# CloudLinux / LiteSpeed Passenger Configuration for api.powergriddiprocoush.org
# Copy or place this file as:
# /home/powergri/api.powergriddiprocoush.org/.htaccess
# (or the configured DocumentRoot of api.powergriddiprocoush.org)
# ==============================================================================

# 1. DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/powergri/repositories/pgcb-org-portal/services/api"
PassengerBaseURI "/"
PassengerPython "/home/powergri/virtualenv/repositories/pgcb-org-portal/services/api/3.11/bin/python"
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# 2. Security & Performance Directives
Options -Indexes -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Access-Control-Allow-Origin "https://powergriddiprocoush.org"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Request-ID"
</IfModule>

# Handle CORS pre-flight OPTIONS directly if not passed to WSGI
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]
