# ==============================================================================
# PGCB Organizational Portal — Production Environment Template (HostSeba v1.0.0-rc1)
# ==============================================================================

# 1. Core Application & Environment
APP_ENV=production
DATABASE_URL=postgresql+psycopg2://pgcb_user:replace_with_strong_db_password@127.0.0.1:5432/pgcb_portal_prod
JWT_SECRET=replace-with-a-cryptographically-random-64-byte-hex-secret
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token
MFA_ENCRYPTION_KEY=replace-with-fernet-32-byte-base64-key

# 2. Frontend & Backend Origin URLs
FRONTEND_URL=https://pgcbportal.org.bd
BACKEND_URL=https://api.pgcbportal.org.bd
NEXT_PUBLIC_SITE_URL=https://pgcbportal.org.bd
NEXT_PUBLIC_API_BASE_URL=https://api.pgcbportal.org.bd/api/v1
ALLOWED_ORIGINS=https://pgcbportal.org.bd,https://staging.pgcbportal.org.bd

# 3. Authentication & Security Hardening
PASSWORD_RESET_HOURS=2
EMAIL_VERIFICATION_HOURS=24
REQUIRE_EMAIL_VERIFICATION=true
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SCHEME=redis
REDIS_TLS_VERIFY=true
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO

# 4. Persistent File Storage (HostSeba Local Disk Outside Public Web Root)
STORAGE_BACKEND=local
UPLOAD_DIRECTORY=/home/pgcbuser/storage/uploads
BACKUP_DIRECTORY=/home/pgcbuser/storage/backups
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_USE_MANAGED_IDENTITY=false
AZURE_STORAGE_CONTAINER=pgcb-files
AZURE_KEY_VAULT_URI=

# 5. Transactional Email (SMTP) & SMS Gateway
SMTP_HOST=mail.pgcbportal.org.bd
SMTP_PORT=587
SMTP_USERNAME=noreply@pgcbportal.org.bd
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=PGCB Secretariat <noreply@pgcbportal.org.bd>
SMS_PROVIDER_URL=
SMS_PROVIDER_NAME=

# 6. Payment Gateways (bKash, Nagad, SSLCommerz)
PAYMENT_WEBHOOK_SECRET=replace-with-hmac-sha256-webhook-secret

# bKash Tokenized Checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=
BKASH_CHECKOUT_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

# Nagad Merchant Gateway
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_WEBHOOK_SECRET=
NAGAD_CHECKOUT_URL=https://api.mynagad.com/api/dfs

# SSLCommerz Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_WEBHOOK_SECRET=
SSLCOMMERZ_CHECKOUT_URL=https://securepay.sslcommerz.com

# 7. Observability & Scheduled Jobs
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-prometheus-scrape-token
WORKER_INTERVAL_SECONDS=30
