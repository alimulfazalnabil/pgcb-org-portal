# ==============================================================================
# PGCB Organization Portal — Root Environment Template (HostSeba v1.0.0-rc1)
# ==============================================================================
# Target Platform: HostSeba cPanel / CloudLinux / Phusion Passenger
# Production Subdomain: https://api.powergriddiprocoush.org
# Production Frontend: https://powergriddiprocoush.org
# Database: PostgreSQL (Psycopg 3 driver: postgresql+psycopg://...)
# ==============================================================================

# 1. Core Environment
APP_ENV=production
LOG_LEVEL=INFO

# 2. Database Connection
# Created via cPanel -> PostgreSQL Databases
DATABASE_URL=postgresql+psycopg://powergri_pgcbuser:ReplaceWithStrongDbPassword@localhost:5432/powergri_pgcb_prod
ALLOW_SQLITE_IN_PRODUCTION=false
ALLOW_STARTUP_FALLBACK=false

# 3. Cryptography & Authentication
SECRET_KEY=replace-with-a-cryptographically-random-64-byte-hex-secret
JWT_SECRET=replace-with-a-cryptographically-random-64-byte-hex-secret
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token

# MFA Encryption Key: 32-byte urlsafe base64 Fernet key.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=replace-with-fernet-32-byte-base64-key==

# 4. Domains & CORS
FRONTEND_URL=https://powergriddiprocoush.org
BACKEND_URL=https://api.powergriddiprocoush.org
NEXT_PUBLIC_SITE_URL=https://powergriddiprocoush.org
NEXT_PUBLIC_API_BASE_URL=https://api.powergriddiprocoush.org/api/v1
NEXT_PUBLIC_API_URL=https://api.powergriddiprocoush.org
INTERNAL_API_URL=https://api.powergriddiprocoush.org
ALLOWED_ORIGINS=https://powergriddiprocoush.org

# 5. Security Hardening
PASSWORD_RESET_HOURS=2
EMAIL_VERIFICATION_HOURS=24
REQUIRE_EMAIL_VERIFICATION=true
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=false
TRUSTED_PROXY_COUNT=1

# 6. Persistent File Storage (Outside public web root in /home/powergri/storage)
STORAGE_BACKEND=local
STORAGE_ROOT=/home/powergri/storage
UPLOAD_DIR=/home/powergri/storage/uploads
MAX_UPLOAD_MB=10

# 7. Transactional Email & SMS
SMTP_HOST=mail.powergriddiprocoush.org
SMTP_PORT=587
SMTP_USERNAME=noreply@powergriddiprocoush.org
SMTP_PASSWORD=replace-with-cpanel-email-password
SMTP_FROM=PGCB Secretariat <noreply@powergriddiprocoush.org>
SMS_PROVIDER_URL=
SMS_PROVIDER_NAME=CUSTOM_HTTP

# 8. Payment Gateways (Sandbox Mode by Default)
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-hmac-sha256-webhook-secret
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=
BKASH_CHECKOUT_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_WEBHOOK_SECRET=
NAGAD_CHECKOUT_URL=https://api.mynagad.com/api/dfs
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_WEBHOOK_SECRET=
SSLCOMMERZ_CHECKOUT_URL=https://securepay.sslcommerz.com

# 9. Observability & Background Jobs
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-prometheus-scrape-token
WORKER_INTERVAL_SECONDS=30
