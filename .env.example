APP_ENV=development
DATABASE_URL=sqlite:///./pgcb_portal.db
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_HOURS=2
EMAIL_VERIFICATION_HOURS=24
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SCHEME=redis
REDIS_TLS_VERIFY=true
MFA_ENCRYPTION_KEY=
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_USE_MANAGED_IDENTITY=true
AZURE_STORAGE_CONTAINER=pgcb-files
AZURE_KEY_VAULT_URI=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER_URL=
SMS_PROVIDER_NAME=
METRICS_ENABLED=true
METRICS_TOKEN=
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO

# Background worker
WORKER_INTERVAL_SECONDS=30

# Payment gateway adapter secrets (configure only the providers you use)
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
BKASH_WEBHOOK_SECRET=
NAGAD_WEBHOOK_SECRET=
SSLCOMMERZ_WEBHOOK_SECRET=
BKASH_CHECKOUT_URL=
NAGAD_CHECKOUT_URL=
SSLCOMMERZ_CHECKOUT_URL=

NEXT_PUBLIC_SITE_URL=https://example.org
