# ==============================================================================
# PGCB Organization Portal — Frontend Web App Environment Template
# ==============================================================================

# Target Production: HostSeba cPanel (https://powergriddiprocoush.org)
# Local Development: http://localhost:3000

# Browser-visible API base path. Browser requests route to /backend and are rewritten server-side.
NEXT_PUBLIC_API_BASE_PATH=/backend

# Backend Target URL for Next.js server-side rewrites and SSR:
# Development: http://127.0.0.1:8000
# Production: https://api.powergriddiprocoush.org
INTERNAL_API_URL=https://api.powergriddiprocoush.org

# Optional direct public API URL fallback
NEXT_PUBLIC_API_URL=https://api.powergriddiprocoush.org

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://powergriddiprocoush.org
