# PGCB Organization Portal — Test & CI Environment (.env.test.example)
APP_ENV=test
# For fast local unit tests: sqlite:///./test.db
# For PostgreSQL integration tests: postgresql+psycopg://pgcb_test:pgcb_test_pass@localhost:5432/pgcb_test_db
DATABASE_URL=postgresql+psycopg://pgcb_test:pgcb_test_pass@localhost:5432/pgcb_test_db
JWT_SECRET=test-secret-32-characters-minimum-for-ci
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=pgcb_access_token
FRONTEND_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=false
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
PAYMENT_WEBHOOK_SECRET=unit-test-payment-secret
